# Copy to .env and fill in AUTH_JWT_PRIVATE_KEY. make reads this file, so
# make run picks it up. Values must not contain a # or make truncates them.

BASE_URL=http://localhost:8080
LOG_DIR=logs
LOG_MAX_AGE_DAYS=365

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# seconds to let in-flight requests drain on shutdown
HTTP_SHUTDOWN_TIMEOUT=15
# max request body in bytes
HTTP_BODY_LIMIT=4194304

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hst
POSTGRES_PASSWORD=hst
POSTGRES_DB=hst
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_CONN=20
POSTGRES_MIN_CONN=2

REDIS_URL=localhost:6379
# set this in production, redis holds every live session
REDIS_PASSWORD=
# managed redis normally requires tls
REDIS_TLS=false
REDIS_DB=0
REDIS_POOL_SIZE=

NATS_HOST=localhost
NATS_PORT=4222
NATS_NAME=hstserver

# shared secret for hst-quote / hst-news internal API (X-Service-Token header)
INTERNAL_SERVICE_TOKEN=dev-service-token

# base64 ed25519 seed, print one with: make gen-keys
# no default on purpose, the server refuses to boot without it
AUTH_JWT_PRIVATE_KEY=
AUTH_ACCESS_TTL=7200
AUTH_REFRESH_TTL=604800

# password for the first administrator defined in seed/managers.go. Only read while
# hst.managers is empty, and the first login is forced through a change.
# Leave empty once the server has run once.
FIRST_MANAGER_PASSWORD=Bootstrap-Admin-2026!

# mixed into every password hash so a database dump alone is not crackable
# changing it invalidates every existing password, so set it once and keep it
AUTH_PASSWORD_PEPPER=

# swagger exposes the whole api surface, keep it false in production
SWAGGER_ENABLED=true

# serve https directly by setting both. Leave both empty behind an ingress or
# load balancer that terminates tls for you.
HTTP_TLS_CERT=
HTTP_TLS_KEY=

# cors allowlist, comma separated, never a wildcard
CORS_ORIGINS=http://localhost:3000

# addresses or CIDR ranges whose X-Forwarded-For is believed, comma separated.
# Set it to the ingress or load balancer in front of this service, e.g. the
# pod CIDR 10.42.0.0/16. Leave it empty when nothing proxies the service:
# every client then reports its socket address, which cannot be forged.
# Getting this wrong is not a startup error, it is every request logging the
# proxy's address, or worse, believing an address the client chose.
TRUSTED_PROXIES=

# where a public signup lands. Blank disables that registration type rather than
# registering into an empty path.
REGISTER_DEMO_GROUP=demo
REGISTER_PRELIMINARY_GROUP=preliminary

# benchmark on the real node, a laptop is not production
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_TIME=3

# session cache sharding. SHARD_COUNT must equal the instance count and every
# instance needs its own SHARD_ID, otherwise each one caches everything.
# In kubernetes SHARD_ID comes from the pod-index label.
SHARD_ID=0
SHARD_COUNT=1
# 100 is fine for local development. Measured 552 bytes per session, so a
# production value of 100000 is about 53 MiB per instance.
MAX_ACCOUNT_PER_SHARD=100

# tick history for charts, written by hst-quote and read back by the history endpoints
INFLUX_ENABLED=false
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=HybridSolutions
INFLUX_BUCKET=marketwatch
