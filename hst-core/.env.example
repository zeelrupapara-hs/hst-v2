# Copy to .env and adjust. make reads this file, so make run picks it up.
# Values must not contain a # or make truncates them.

LOG_DIR=logs
LOG_MAX_AGE_DAYS=365

# probe listener, kept on its own port so a probe never queues behind
# application traffic and the port can stay off the public service
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8081
# seconds to keep serving after readiness starts failing, so the endpoints
# controller routes away first. At least twice the readiness probe period.
HEALTH_DRAIN_WAIT=5

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hst
POSTGRES_PASSWORD=hst
POSTGRES_DB=hst
# disable is for local docker only, production must be require or verify-full
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_CONN=20
POSTGRES_MIN_CONN=2

NATS_HOST=localhost
NATS_PORT=4222
NATS_NAME=hstcore

REDIS_URL=localhost:6379
REDIS_PASSWORD=
# managed redis normally requires tls
REDIS_TLS=false
REDIS_DB=0
REDIS_POOL_SIZE=

# how old a last price may be and still seed the engine at start; beyond it the instrument
# starts with no price, which refuses a trade rather than filling at a stale mark
ENGINE_PRICE_MAX_AGE_HOURS=72
