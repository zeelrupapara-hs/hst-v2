# Copy to .env and adjust. make reads this file, so make run picks it up.
# Values must not contain a # or make truncates them.

LOG_DIR=logs
LOG_MAX_AGE_DAYS=365

# grpc listener
GRPC_HOST=0.0.0.0
GRPC_PORT=3001
# seconds to let in-flight rpcs drain on shutdown
GRPC_SHUTDOWN_TIMEOUT=15

# probe listener, kept on its own port so a probe never queues behind
# application traffic and the port can stay off the public service
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8081
# seconds to keep serving after readiness starts failing, so the endpoints
# controller routes away first. At least twice the readiness probe period.
HEALTH_DRAIN_WAIT=5

NATS_HOST=localhost
NATS_PORT=4222
NATS_NAME=hstquote

HST_SERVER_URL=http://localhost:8080
INTERNAL_SERVICE_TOKEN=dev-service-token
QUOTE_INSTANCE_INDEX=0
QUOTE_INSTANCE_COUNT=1

QUOTE_RELOAD_INTERVAL=60
FIX_CONFIG_DIR=logs/fix

INFLUX_ENABLED=true
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=dev-influx-token
INFLUX_ORG=HybridSolutions
INFLUX_BUCKET=marketwatch

REDIS_URL=localhost:6379
REDIS_PASSWORD=
# managed redis normally requires tls
REDIS_TLS=false
REDIS_DB=0
REDIS_POOL_SIZE=

# raw ticks are staging; the minute bars are the history a chart reads
INFLUX_CANDLE_BUCKET=marketwatch_candles
INFLUX_TICK_RETENTION_DAYS=7
