# Staging environment for /opt/hst/.env on the droplet. Copy, fill the CHANGE_ME secrets,
# and never commit the filled file. Hostnames point at the compose service names.

BASE_URL=http://168.144.127.209:8080
LOG_MAX_AGE_DAYS=30

HTTP_PORT=8080
HTTP_SHUTDOWN_TIMEOUT=15
HTTP_BODY_LIMIT=4194304

POSTGRES_PORT=5432
POSTGRES_USER=hst
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=hst
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_CONN=20
POSTGRES_MIN_CONN=2

REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=

NATS_PORT=4222
NATS_NAME=hstserver

# base64 ed25519 seed from hst-server/cmd/genkeys
AUTH_JWT_PRIVATE_KEY=CHANGE_ME
AUTH_ACCESS_TTL=7200
AUTH_REFRESH_TTL=604800
AUTH_PASSWORD_PEPPER=CHANGE_ME
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_TIME=3
AUTH_LOG_CREDENTIALS=false

SWAGGER_ENABLED=false
CORS_ORIGINS=http://168.144.127.209,http://168.144.127.209:8081

SHARD_ID=0
SHARD_COUNT=1
MAX_ACCOUNT_PER_SHARD=100

FIRST_MANAGER_PASSWORD=CHANGE_ME
INTERNAL_SERVICE_TOKEN=CHANGE_ME

INFLUX_TOKEN=CHANGE_ME
INFLUX_ADMIN_PASSWORD=CHANGE_ME
INFLUX_ORG=HybridSolutions
INFLUX_BUCKET=marketwatch
INFLUX_CANDLE_BUCKET=marketwatch_candles
INFLUX_TICK_RETENTION_DAYS=7

# hst-core
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8091
HEALTH_DRAIN_WAIT=5
ENGINE_PRICE_MAX_AGE_HOURS=72

# hst-quote
GRPC_HOST=0.0.0.0
GRPC_PORT=3001
GRPC_SHUTDOWN_TIMEOUT=15
QUOTE_INSTANCE_INDEX=0
QUOTE_INSTANCE_COUNT=1
QUOTE_RELOAD_INTERVAL=60
